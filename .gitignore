# Dependencies
node_modules/

# Build output
out/
dist/
release/
*.dmg
*.blockmap

# LibreOffice headless build artifacts (produced by CI / build script)
scripts/lok/instdir/
scripts/lok/core/
scripts/lok/*.ppm
scripts/lok/lokprobe
scripts/lok/wos-lok-host
scripts/lok/LibreOfficeKit/

# Local tooling state
.swarm/
.claude-flow/
.claude/
.mcp.json
# Shadow-git checkpoint repo (agent-run undo history — machine-local state,
# and it can leak workspace content into commits)
.workspace-os/

# e2e transient build output (e2e/mail transpiles prod TS → CJS here, self-cleaned)
e2e/**/.build-*/

# Caches
.vite/
*.log
.DS_Store

# Secrets — never commit
.env
.env.*
*.pem
*.key
secrets.json
# MCP vault state (encrypted vault + enabled-connector list + generated config)
mcp-connectors.json
**/.mcp.json

# LibreOffice lock files
.~lock.*#
/undefined/

# Demo recordings — large binaries, regenerated by scripts/demo/record-demo.mjs
build/demo/

# Demo clip output — regenerated by scripts/demo/record-clips.mjs
build/demo/
docs/pitch/_print.html
docs/pitch/*.pdf
.playwright-mcp/
