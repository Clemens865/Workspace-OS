<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened-runtime entitlements for Workspace OS.

      Used for BOTH the app and its child processes (electron-builder
      `entitlements` + `entitlementsInherit`). Kept intentionally conservative:
      only the capabilities Electron and the bundled LibreOffice sidecar
      actually require. See docs/HARDENING.md for the rationale per key.
    -->

    <!-- Electron / V8 JIT: the renderer's JavaScript engine compiles to
         executable memory at runtime. Required for Electron under hardened
         runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- V8 additionally maps writable+executable pages; hardened runtime
         blocks this without the entitlement. Standard for Electron apps. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- We bundle LibreOffice.app (LibreOfficeKit sidecar) plus native Node
         addons (better-sqlite3, node-pty). Library validation would refuse to
         load dylibs/plugins not signed by our Team ID; disabling it lets the
         signed app load the bundled LibreOffice libraries and .node modules. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- LibreOffice's launcher sets DYLD_* environment variables to locate its
         bundled libraries. Hardened runtime strips these unless allowed. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
